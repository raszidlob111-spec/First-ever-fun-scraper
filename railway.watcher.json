{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildEnvironment": "V3"
  },
  "deploy": {
    "startCommand": "python watcher.py --once",
    "cronSchedule": "*/10 * * * *",
    "runtime": "V2",
    "numReplicas": 1,
    "useLegacyStacker": false,
    "ipv6EgressEnabled": false,
    "multiRegionConfig": {
      "sfo": {
        "numReplicas": 1
      }
    },
    "restartPolicyType": "NEVER"
  }
}
